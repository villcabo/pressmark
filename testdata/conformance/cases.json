[
  {
    "name": "inherits tokens from base",
    "why": "A theme that declares no extends inherits from _base. The parent's tokens reach the child.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "Base",
          "version": "1.0.0",
          "extends": null,
          "tokens": {
            "acento": "#111111",
            "tinta": "#222222"
          }
        },
        "css": "a { color: var(--acento); }"
      },
      "hijo": {
        "json": {
          "id": "hijo",
          "name": "Hijo",
          "version": "1.0.0"
        },
        "css": "b { color: red; }"
      }
    },
    "load": "hijo",
    "expect": {
      "chain": [
        "_base",
        "hijo"
      ],
      "tokens": {
        "acento": "#111111",
        "tinta": "#222222"
      },
      "css": "a { color: var(--acento); } b { color: red; }"
    }
  },
  {
    "name": "the child overrides token by token",
    "why": "Token merging is key by key, not a wholesale object replacement.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "Base",
          "version": "1.0.0",
          "extends": null,
          "tokens": {
            "acento": "#111111",
            "tinta": "#222222",
            "regla": "#333333"
          }
        },
        "css": ""
      },
      "hijo": {
        "json": {
          "id": "hijo",
          "name": "Hijo",
          "version": "1.0.0",
          "tokens": {
            "acento": "#ff0000"
          }
        },
        "css": ""
      }
    },
    "load": "hijo",
    "expect": {
      "tokens": {
        "acento": "#ff0000",
        "tinta": "#222222",
        "regla": "#333333"
      }
    }
  },
  {
    "name": "extends null inherits nothing",
    "why": "extends null cuts the chain. It is not the same as omitting extends.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "Base",
          "version": "1.0.0",
          "extends": null,
          "tokens": {
            "acento": "#111111"
          }
        },
        "css": "a{}"
      },
      "suelto": {
        "json": {
          "id": "suelto",
          "name": "Suelto",
          "version": "1.0.0",
          "extends": null,
          "tokens": {
            "propio": "#999999"
          }
        },
        "css": "b{}"
      }
    },
    "load": "suelto",
    "expect": {
      "chain": [
        "suelto"
      ],
      "tokens": {
        "propio": "#999999"
      },
      "css": "b{}"
    }
  },
  {
    "name": "three-level chain",
    "why": "Inheritance follows the whole chain, and CSS stacks from the furthest ancestor down to the theme itself.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "B",
          "version": "1.0.0",
          "extends": null,
          "tokens": {
            "a": "1",
            "b": "1",
            "c": "1"
          }
        },
        "css": "/*1*/"
      },
      "medio": {
        "json": {
          "id": "medio",
          "name": "M",
          "version": "1.0.0",
          "extends": "_base",
          "tokens": {
            "b": "2",
            "c": "2"
          }
        },
        "css": "/*2*/"
      },
      "hoja": {
        "json": {
          "id": "hoja",
          "name": "H",
          "version": "1.0.0",
          "extends": "medio",
          "tokens": {
            "c": "3"
          }
        },
        "css": "/*3*/"
      }
    },
    "load": "hoja",
    "expect": {
      "chain": [
        "_base",
        "medio",
        "hoja"
      ],
      "tokens": {
        "a": "1",
        "b": "2",
        "c": "3"
      },
      "css": "/*1*/ /*2*/ /*3*/"
    }
  },
  {
    "name": "partial margin",
    "why": "page.margin merges side by side. Declaring only left must not wipe the other three.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "B",
          "version": "1.0.0",
          "extends": null,
          "page": {
            "size": "A4",
            "printBackground": true,
            "margin": {
              "top": "20mm",
              "right": "18mm",
              "bottom": "18mm",
              "left": "18mm"
            }
          }
        },
        "css": ""
      },
      "hijo": {
        "json": {
          "id": "hijo",
          "name": "H",
          "version": "1.0.0",
          "page": {
            "margin": {
              "left": "30mm"
            }
          }
        },
        "css": ""
      }
    },
    "load": "hijo",
    "expect": {
      "page": {
        "size": "A4",
        "printBackground": true,
        "margin": {
          "top": "20mm",
          "right": "18mm",
          "bottom": "18mm",
          "left": "30mm"
        }
      }
    }
  },
  {
    "name": "partial band",
    "why": "The footer merges field by field: changing only the left slot keeps the rest.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "B",
          "version": "1.0.0",
          "extends": null,
          "footer": {
            "enabled": true,
            "left": "viejo",
            "right": "{{page}}",
            "rule": true,
            "fontSize": "7pt",
            "color": "#888888"
          }
        },
        "css": ""
      },
      "hijo": {
        "json": {
          "id": "hijo",
          "name": "H",
          "version": "1.0.0",
          "footer": {
            "left": "nuevo"
          }
        },
        "css": ""
      }
    },
    "load": "hijo",
    "expect": {
      "footer": {
        "enabled": true,
        "left": "nuevo",
        "right": "{{page}}",
        "rule": true,
        "fontSize": "7pt",
        "color": "#888888"
      }
    }
  },
  {
    "name": "an explicit false overrides true",
    "why": "A boolean set to false is NOT the same as absent. cover.enabled:false has to beat true.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "B",
          "version": "1.0.0",
          "extends": null,
          "cover": {
            "enabled": true,
            "break": "page"
          }
        },
        "css": ""
      },
      "hijo": {
        "json": {
          "id": "hijo",
          "name": "H",
          "version": "1.0.0",
          "cover": {
            "enabled": false
          }
        },
        "css": ""
      }
    },
    "load": "hijo",
    "expect": {
      "cover": {
        "enabled": false,
        "break": "page"
      }
    }
  },
  {
    "name": "vars merge",
    "why": "vars merge key by key, exactly like tokens.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "B",
          "version": "1.0.0",
          "extends": null,
          "vars": {
            "aviso": "interno",
            "pie": "x"
          }
        },
        "css": ""
      },
      "hijo": {
        "json": {
          "id": "hijo",
          "name": "H",
          "version": "1.0.0",
          "vars": {
            "aviso": "publico"
          }
        },
        "css": ""
      }
    },
    "load": "hijo",
    "expect": {
      "vars": {
        "aviso": "publico",
        "pie": "x"
      }
    }
  },
  {
    "name": "identity comes from the requested theme",
    "why": "id, name and description come from the theme asked for, not from the ancestor it inherits from.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "Base",
          "description": "la base",
          "version": "9.9.9",
          "extends": null
        },
        "css": ""
      },
      "hijo": {
        "json": {
          "id": "hijo",
          "name": "Hijo",
          "description": "el hijo",
          "version": "1.0.0"
        },
        "css": ""
      }
    },
    "load": "hijo",
    "expect": {
      "id": "hijo",
      "name": "Hijo",
      "description": "el hijo",
      "version": "1.0.0"
    }
  },
  {
    "name": "a numeric token becomes text",
    "why": "The schema allows numbers in tokens; once emitted as a CSS variable everything is text.",
    "packs": {
      "_base": {
        "json": {
          "id": "_base",
          "name": "B",
          "version": "1.0.0",
          "extends": null,
          "tokens": {
            "escala": 1.5,
            "peso": 700
          }
        },
        "css": ""
      }
    },
    "load": "_base",
    "expect": {
      "tokens": {
        "escala": "1.5",
        "peso": "700"
      }
    }
  },
  {
    "name": "circular inheritance fails",
    "why": "A cycle must produce a clear error, not hang the process.",
    "packs": {
      "a": {
        "json": {
          "id": "a",
          "name": "A",
          "version": "1.0.0",
          "extends": "b"
        },
        "css": ""
      },
      "b": {
        "json": {
          "id": "b",
          "name": "B",
          "version": "1.0.0",
          "extends": "a"
        },
        "css": ""
      }
    },
    "load": "a",
    "expectError": "circular"
  },
  {
    "name": "a missing parent fails",
    "why": "Inheriting from a theme that does not exist must fail, not half-resolve.",
    "packs": {
      "hijo": {
        "json": {
          "id": "hijo",
          "name": "H",
          "version": "1.0.0",
          "extends": "fantasma"
        },
        "css": ""
      }
    },
    "load": "hijo",
    "expectError": "fantasma"
  },
  {
    "name": "a mismatched id fails",
    "why": "The declared id must match the folder, or extends resolution is lying.",
    "packs": {
      "carpeta": {
        "json": {
          "id": "otro",
          "name": "X",
          "version": "1.0.0",
          "extends": null
        },
        "css": ""
      }
    },
    "load": "carpeta",
    "expectError": "otro"
  }
]
