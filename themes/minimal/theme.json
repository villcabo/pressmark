{
  "$schema": "../theme.schema.json",
  "id": "minimal",
  "name": {
    "en": "Minimal",
    "es": "Minimal"
  },
  "description": {
    "en": "Not a single color. Typography and space. Prints the same in black and white.",
    "es": "Sin un solo color. Tipografía y espacio. Imprime igual en blanco y negro."
  },
  "version": "1.0.0",
  "extends": "_base",
  "tokens": {
    "acento": "#1c1c1c",
    "acento-tenue": "#f5f5f5",
    "acento-medio": "#cfcfcf",
    "tinta": "#131313",
    "tenue": "#6d6d6d",
    "regla": "#d9d9d9",
    "papel-codigo": "#f6f6f6",
    "aviso": "#4a4a4a",
    "aviso-fondo": "#f7f7f7",
    "portada-offset": "82mm"
  },
  "page": {
    "size": "A4",
    "margin": {
      "top": "28mm",
      "right": "25mm",
      "bottom": "22mm",
      "left": "25mm"
    },
    "printBackground": true
  },
  "cover": {
    "enabled": true,
    "break": "page"
  },
  "footer": {
    "enabled": true,
    "left": "{{vars.confidencialidad}}",
    "right": {
      "en": "Page {{page}} of {{pages}}",
      "es": "Página {{page}} de {{pages}}"
    },
    "rule": true,
    "fontSize": "7pt",
    "color": "#8a8a8a"
  },
  "vars": {
    "confidencialidad": {
      "en": "Confidential · internal use",
      "es": "Confidencial · uso interno"
    }
  },
  "varSchema": {
    "confidencialidad": {
      "type": "text",
      "label": {
        "en": "Confidentiality notice",
        "es": "Aviso de confidencialidad"
      },
      "group": "pie",
      "description": {
        "en": "Shown on the left side of the page footer. A note can override it from its frontmatter with {{fm.<field>}}.",
        "es": "Se muestra a la izquierda del pie de página. Una nota puede pisarlo desde su frontmatter con {{fm.<campo>}}."
      }
    }
  }
}
