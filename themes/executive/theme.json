{
  "$schema": "../theme.schema.json",
  "id": "executive",
  "name": {
    "en": "Executive",
    "es": "Ejecutivo"
  },
  "description": {
    "en": "Serif headings, ink blue, plenty of air. For leadership and steering committees.",
    "es": "Títulos en serif, azul de tinta, mucho aire. Para dirección y comité."
  },
  "version": "1.0.0",
  "extends": "_base",
  "tokens": {
    "accent": "#1a3a5c",
    "accent-soft": "#f0f4f8",
    "accent-mid": "#c6d5e2",
    "ink": "#16202b",
    "muted": "#5b6b7c",
    "rule": "#d5dde5",
    "code-bg": "#f5f8fa",
    "font-heading": "Georgia, \"DejaVu Serif\", \"Liberation Serif\", serif",
    "cover-offset": "72mm"
  },
  "page": {
    "size": "A4",
    "margin": {
      "top": "26mm",
      "right": "23mm",
      "bottom": "20mm",
      "left": "23mm"
    },
    "printBackground": true
  },
  "cover": {
    "enabled": true,
    "break": "page"
  },
  "footer": {
    "enabled": true,
    "left": "{{vars.confidentiality}}",
    "right": {
      "en": "Page {{page}} of {{pages}}",
      "es": "Página {{page}} de {{pages}}"
    },
    "rule": true,
    "fontSize": "7pt",
    "color": "#7c8b99"
  },
  "vars": {
    "confidentiality": {
      "en": "Confidential · internal use",
      "es": "Confidencial · uso interno"
    }
  },
  "varSchema": {
    "confidentiality": {
      "type": "text",
      "label": {
        "en": "Confidentiality notice",
        "es": "Aviso de confidencialidad"
      },
      "group": "footer",
      "description": {
        "en": "Shown on the left side of the page footer. A note can override it from its frontmatter with {{fm.<field>}}.",
        "es": "Se muestra a la izquierda del pie de página. Una nota puede pisarlo desde su frontmatter con {{fm.<campo>}}."
      }
    }
  }
}
