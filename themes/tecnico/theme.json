{
  "$schema": "../theme.schema.json",
  "id": "tecnico",
  "name": {
    "en": "Technical",
    "es": "Técnico"
  },
  "description": {
    "en": "Dense, graphite, half-page cover. The code leads.",
    "es": "Denso, grafito, portada de media carilla. El código manda."
  },
  "version": "1.0.0",
  "extends": "_base",
  "tokens": {
    "acento": "#33475b",
    "acento-tenue": "#f1f4f7",
    "acento-medio": "#c8d3dd",
    "tinta": "#1b2733",
    "tenue": "#5d6b78",
    "regla": "#d9e0e6",
    "papel-codigo": "#f4f7f9",
    "portada-offset": "22mm"
  },
  "page": {
    "size": "A4",
    "margin": {
      "top": "20mm",
      "right": "16mm",
      "bottom": "18mm",
      "left": "16mm"
    },
    "printBackground": true
  },
  "cover": {
    "enabled": true,
    "break": "page"
  },
  "footer": {
    "enabled": true,
    "left": "{{vars.confidencialidad}}",
    "right": {
      "en": "Page {{page}} of {{pages}}",
      "es": "Página {{page}} de {{pages}}"
    },
    "rule": true,
    "fontSize": "7pt",
    "color": "#8a9499"
  },
  "vars": {
    "confidencialidad": {
      "en": "Confidential · internal use",
      "es": "Confidencial · uso interno"
    }
  },
  "varSchema": {
    "confidencialidad": {
      "type": "text",
      "label": {
        "en": "Confidentiality notice",
        "es": "Aviso de confidencialidad"
      },
      "group": "pie",
      "description": {
        "en": "Shown on the left side of the page footer. A note can override it from its frontmatter with {{fm.<field>}}.",
        "es": "Se muestra a la izquierda del pie de página. Una nota puede pisarlo desde su frontmatter con {{fm.<campo>}}."
      }
    }
  }
}
