{
  "$schema": "../theme.schema.json",
  "id": "informe",
  "name": {
    "en": "Report",
    "es": "Informe"
  },
  "description": {
    "en": "Formal document with a cover page and generous margins. The canonical one.",
    "es": "Documento formal con portada y márgenes amplios. El canónico."
  },
  "version": "1.0.0",
  "extends": "_base",
  "tokens": {
    "portada-offset": "58mm"
  },
  "page": {
    "size": "A4",
    "margin": {
      "top": "24mm",
      "right": "19mm",
      "bottom": "18mm",
      "left": "19mm"
    },
    "printBackground": true
  },
  "cover": {
    "enabled": true,
    "break": "page"
  },
  "footer": {
    "enabled": true,
    "left": "{{vars.confidencialidad}}",
    "right": {
      "en": "Page {{page}} of {{pages}}",
      "es": "Página {{page}} de {{pages}}"
    },
    "rule": true,
    "fontSize": "7pt",
    "color": "#8a9099"
  },
  "vars": {
    "confidencialidad": {
      "en": "Confidential · internal use",
      "es": "Confidencial · uso interno"
    }
  },
  "varSchema": {
    "confidencialidad": {
      "type": "text",
      "label": {
        "en": "Confidentiality notice",
        "es": "Aviso de confidencialidad"
      },
      "group": "pie",
      "description": {
        "en": "Shown on the left side of the page footer. A note can override it from its frontmatter with {{fm.<field>}}.",
        "es": "Se muestra a la izquierda del pie de página. Una nota puede pisarlo desde su frontmatter con {{fm.<campo>}}."
      }
    }
  }
}
