{
  "$schema": "../theme.schema.json",
  "id": "modern",
  "name": {
    "en": "Modern",
    "es": "Moderno"
  },
  "description": {
    "en": "Inter Display, plum, soft corners. For proposals and product docs.",
    "es": "Inter Display, ciruela, esquinas suaves. Para propuestas y producto."
  },
  "version": "1.0.0",
  "extends": "_base",
  "tokens": {
    "accent": "#6b2d5c",
    "accent-soft": "#faf3f8",
    "accent-mid": "#ddc2d5",
    "ink": "#241d22",
    "muted": "#6b5f67",
    "rule": "#e3d9e0",
    "code-bg": "#faf7f9",
    "notice": "#8a5a12",
    "font-heading": "\"Inter Display\", \"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "cover-offset": "62mm"
  },
  "page": {
    "size": "A4",
    "margin": {
      "top": "24mm",
      "right": "21mm",
      "bottom": "20mm",
      "left": "21mm"
    },
    "printBackground": true
  },
  "cover": {
    "enabled": true,
    "break": "page"
  },
  "footer": {
    "enabled": true,
    "left": "{{vars.confidentiality}}",
    "right": {
      "en": "Page {{page}} of {{pages}}",
      "es": "Página {{page}} de {{pages}}"
    },
    "rule": true,
    "fontSize": "7pt",
    "color": "#7d928f"
  },
  "vars": {
    "confidentiality": {
      "en": "Confidential · internal use",
      "es": "Confidencial · uso interno"
    }
  },
  "varSchema": {
    "confidentiality": {
      "type": "text",
      "label": {
        "en": "Confidentiality notice",
        "es": "Aviso de confidencialidad"
      },
      "group": "footer",
      "description": {
        "en": "Shown on the left side of the page footer. A note can override it from its frontmatter with {{fm.<field>}}.",
        "es": "Se muestra a la izquierda del pie de página. Una nota puede pisarlo desde su frontmatter con {{fm.<campo>}}."
      }
    }
  }
}
