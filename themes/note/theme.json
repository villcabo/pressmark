{
  "$schema": "../theme.schema.json",
  "id": "note",
  "name": {
    "en": "Note",
    "es": "Nota"
  },
  "description": {
    "en": "No cover, straight to the point. Compact, for diagnostics and lists.",
    "es": "Sin portada, arranca directo. Compacto, para diagnósticos y listas."
  },
  "version": "1.0.0",
  "extends": "_base",
  "page": {
    "size": "A4",
    "margin": {
      "top": "18mm",
      "right": "17mm",
      "bottom": "16mm",
      "left": "17mm"
    },
    "printBackground": true
  },
  "cover": {
    "enabled": false,
    "break": "none"
  }
}
