{
  "name": "pressmark",
  "version": "0.4.0",
  "description": "Export Obsidian notes to PDF with portable theme packs.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/validate.mjs && node tools/gen-plugin-themes.mjs && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "validate": "node tools/validate.mjs",
    "lint": "eslint src",
    "test": "bun test src"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pdf",
    "markdown"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  }
}
